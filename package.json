{
  "name": "apex-quant",
  "version": "2.0.0",
  "description": "Semnale Forex/aur/indici pentru examene de prop firm: strategie validată out-of-sample, Gardian pentru regulile firmei, simulator de examen, semnale Telegram cu lot exact.",
  "main": "src/cron.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/live.js",
    "cron": "node src/cron.js",
    "live": "node src/live.js",
    "demo": "node scripts/demo.js",
    "backtest": "node src/backtest/run.js",
    "backtest:synthetic": "node src/backtest/run.js --synthetic --days 120 --seeds 5",
    "research": "node src/research/run.js",
    "research:trend": "node src/research/trendRun.js",
    "test": "node --test",
    "research:prop": "node src/research/propRun.js",
    "research:academy": "node src/research/academyRun.js"
  },
  "dependencies": {}
}