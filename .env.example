# Copiază acest fișier ca ".env" și completează valorile. Fișierul .env NU se urcă pe GitHub.

# Telegram (de la @BotFather) și ID-ul chat-ului tău
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 1 = trimite cu adevărat pe Telegram. Orice altceva = DRY-RUN (mesajele apar doar în consolă).
LIVE_TELEGRAM=0

# Opțional: capitalul contului, ca mesajele să includă mărimea poziției pentru riscul ales
ACCOUNT_EQUITY=

# Cât de des rulează ciclul live (secunde, minim 30)
CYCLE_SECONDS=60

# 1 = evaluează și departamentul SMC (fără semnale, doar în consolă) deși nu e validat
OBSERVE_SMC=0

# Opțional: port pentru endpoint-ul de stare (hosting)
PORT=
